# Copier en .env.local pour le développement.
#
# Next lit .env.local automatiquement : aucune variable à passer sur la ligne
# de commande. Sur Vercel, ces valeurs se renseignent dans les réglages du
# projet.

NEXT_PUBLIC_SITE_URL=http://localhost:3030
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MEDIA_URL=http://localhost:8080

# Doit correspondre au REVALIDATE_SECRET du backend.
REVALIDATE_SECRET=secret-de-developpement-local
